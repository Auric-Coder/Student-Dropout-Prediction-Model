# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── ML model artifacts (regenerate with training script) ──────────────────────
models/*.pkl
models/*.joblib
models/*.h5

# ── Data ──────────────────────────────────────────────────────────────────────
# Large raw datasets — keep the folder, ignore the files
data/*.csv
data/*.xlsx
data/*.zip
# Reference PDFs are intentionally tracked (committed to the repo)
# data/*.pdf

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
*.secret

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Flask ─────────────────────────────────────────────────────────────────────
instance/
*.sqlite3

# ── Results (generated — safe to regenerate via training script) ──────────────
# Uncomment the lines below if you do NOT want to track generated outputs.
# results/academic_indicator_metrics.txt
# results/plots/*.png

# ── AI tooling ────────────────────────────────────────────────────────────────
.gemini/
